{
  "openapi": "3.1.0",
  "info": {
    "title": "Abisal Usage API (simulada)",
    "description": "Uso de los modelos de Abisal por organización. Simulación para el Tema 12 del MID de EBIS. Autenticación con la cabecera X-Abisal-Key. Paginación por cursor: repite la petición con `cursor=next_cursor` hasta que `next_cursor` sea null. Si superas el límite de peticiones, responde 429 con la cabecera Retry-After en segundos.",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/usage": {
      "get": {
        "summary": "Lista el uso entre dos fechas",
        "operationId": "listar_uso_v1_usage_get",
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Fecha inicial incluida, AAAA-MM-DD",
              "title": "Start Date"
            },
            "description": "Fecha inicial incluida, AAAA-MM-DD"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Fecha final incluida, AAAA-MM-DD",
              "title": "End Date"
            },
            "description": "Fecha final incluida, AAAA-MM-DD"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          },
          {
            "name": "x-abisal-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Abisal-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsagePage"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Metadata": {
        "properties": {
          "team": {
            "type": "string",
            "title": "Team"
          },
          "project": {
            "type": "string",
            "title": "Project"
          }
        },
        "type": "object",
        "required": [
          "team",
          "project"
        ],
        "title": "Metadata"
      },
      "Usage": {
        "properties": {
          "input_tokens": {
            "type": "integer",
            "title": "Input Tokens",
            "description": "Tokens de entrada, incluidos los servidos desde caché"
          },
          "output_tokens": {
            "type": "integer",
            "title": "Output Tokens"
          },
          "cached_input_tokens": {
            "type": "integer",
            "title": "Cached Input Tokens",
            "description": "Parte de input_tokens servida desde caché"
          }
        },
        "type": "object",
        "required": [
          "input_tokens",
          "output_tokens",
          "cached_input_tokens"
        ],
        "title": "Usage"
      },
      "UsagePage": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/UsageRecord"
            },
            "type": "array",
            "title": "Data"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor",
            "description": "Cursor de la página siguiente, o null si no hay más"
          }
        },
        "type": "object",
        "required": [
          "data",
          "next_cursor"
        ],
        "title": "UsagePage"
      },
      "UsageRecord": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "Fecha y hora en UTC, ISO 8601"
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "batch": {
            "type": "boolean",
            "title": "Batch"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "created_at",
          "metadata",
          "model",
          "usage",
          "batch"
        ],
        "title": "UsageRecord"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}